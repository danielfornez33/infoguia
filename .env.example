# Base de datos y Redis
DATABASE_URL=postgresql://infoguia:infoguia@localhost:5432/infoguia
REDIS_URL=redis://localhost:6379/0

# Panel de control
PANEL_USER=admin
PANEL_PASSWORD=change-me

# Configuración del scraper
CRAWL_USER_AGENT=InfoGuiaBot/1.0 (+tu-correo@dominio.com)
CRAWL_RPS=0.3
CRAWL_BURST=1
DAILY_CAP=8000
OFF_PEAK_ONLY=false
OFF_PEAK_START=0
OFF_PEAK_END=7

# Almacenamiento
RAW_DIR=/data/raw

# Seeds (URLs iniciales para scrapear)
SEED_URLS=https://infoguia.com/ct.asp?key=repuestos-caracas&cat=738&ciud=41,https://infoguia.com/ct.asp?key=restaurantes-caracas&cat=100&ciud=41

# Características
DISCOVERY_ENABLED=true
PRODUCTS_ENABLED=true
MAX_PAGES_PER_LISTING=50

# HTTP
HTTP_TIMEOUT=30
MAX_RETRIES=3

# Anti-detección (opcional)
PROXY_URLS=
ROTATE_USER_AGENTS=false
PROXY_ROTATION_ENABLED=false
CONDITIONAL_REQUESTS=true
